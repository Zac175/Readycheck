local initFrame = CreateFrame("Frame")
initFrame:RegisterEvent("PLAYER_LOGIN")
initFrame:SetScript("OnEvent", function()
    do
        RC.speedSwapItems = {
            { id = 4984,  name = "Skull of Impending Doom" },
            { id = 7189,  name = "Goblin Rocket Boots" },
            { id = 10724, name = "Gnomish Rocket Boots" },
            { id = 7391,  name = "Swift Boots" },
            { id = 4264,  name = "Barbaric Belt" },
            { id = 6972,  name = "Fire Hardened Hauberk" },
        }
        local REVERT_ITEMS = {}
        for _, e in ipairs(RC.speedSwapItems) do REVERT_ITEMS[e.id] = true end
        local lastKnown = {}
        local pendingPrev = {}
        local watching = nil
        local queued = nil
        local auraTicker = nil
        local expiryTimer = nil

        local f = CreateFrame("Frame")

        local function Enabled()
            return RC.db and RC.db.gearUseRevert ~= false
        end

        local function AnyTrackedWorn()
            for slot = 1, 19 do
                local id = GetInventoryItemID("player", slot)
                if id and REVERT_ITEMS[id] then return true end
            end
            return false
        end

        local function UpdateCastReg()
            if Enabled() and AnyTrackedWorn() then
                f:RegisterUnitEvent("UNIT_SPELLCAST_SUCCEEDED", "player")
            else
                f:UnregisterEvent("UNIT_SPELLCAST_SUCCEEDED")
            end
        end

        -- Two different items can share one on-use spell - Barbaric Belt
        -- and Fire Hardened Hauberk both cast 9174 - so matching on the
        -- spell alone picks whichever slot happens to be scanned first,
        -- and the wrong slot gets reverted. The item you actually used is
        -- the one whose cooldown started just now, so when more than one
        -- worn item claims the spell, let the cooldown break the tie.
        local function PickCastSlot(candidates)
            if #candidates == 0 then return nil end
            if #candidates == 1 then return candidates[1] end
            local now = GetTime()
            local best, bestAge
            for _, slot in ipairs(candidates) do
                local start, dur = GetInventoryItemCooldown("player", slot)
                if start and start > 0 and dur and dur > 1.5 then
                    local age = now - start
                    if age >= 0 and age < 2 and (not bestAge or age < bestAge) then
                        best, bestAge = slot, age
                    end
                end
            end
            return best or candidates[1]
        end

        local function WornCastsSpell(slot, spellId)
            local worn = GetInventoryItemID("player", slot)
            if not worn or not REVERT_ITEMS[worn] then return nil end
            local _, isid = GetItemSpell(worn)
            if isid and isid == spellId then return worn end
            return nil
        end

        local function DoRevert(slot, rec, why)
            if not rec then return end
            if InCombatLockdown() then
                queued = { slot = slot, rec = rec }
                f:RegisterEvent("PLAYER_REGEN_ENABLED")
                RC:DebugPrint("Swapback queued to combat end (slot " .. slot .. ")", "gear")
                return
            end
            local prev = (RC.db.speedSwapTargets
                and RC.db.speedSwapTargets[rec.item]) or rec.prev
            if not prev or prev == 0 then
                RC:DebugPrint("Swapback skipped: nothing to restore for"
                    .. " slot " .. slot .. " (no recorded previous, no"
                    .. " configured target)", "gear")
                return
            end
            if RC.db and RC.db.speedSwapPending then
                RC.db.speedSwapPending[slot] = nil
            end
            local worn = GetInventoryItemID("player", slot)
            if worn and not REVERT_ITEMS[worn] then
                return
            end
            RC:FastEquipItem(prev, slot)
            RC:DebugPrint("Swapback: slot " .. slot .. " -> item " .. prev
                .. " (" .. why .. ")", "gear")
        end

        -- How long to look for a buff before concluding the item grants
        -- none. A use effect's aura lands on the same frame as the cast, so
        -- this only has to cover a couple of frames - and every tenth of a
        -- second here is a tenth the slot spends holding the wrong item on
        -- a speedrun pull.
        local DISCOVERY_WINDOW = 0.3

        local function StopAuraTicker()
            if auraTicker then
                auraTicker:Cancel()
                auraTicker = nil
            end
        end

        local function StopExpiryTimer()
            if expiryTimer then
                expiryTimer:Cancel()
                expiryTimer = nil
            end
        end

        local function FinishWatch(w, why)
            watching = nil
            StopAuraTicker()
            StopExpiryTimer()
            if RC.UnregisterUnitAuraCallback then
                RC:UnregisterUnitAuraCallback("GearUseRevert")
            end
            DoRevert(w.slot, pendingPrev[w.slot], why)
            pendingPrev[w.slot] = nil
        end

        local function AuraTick()
            local w = watching
            if not w then return end
            local now = GetTime()
            if not w.spellId then
                for i = 1, 40 do
                    local name, _, _, _, dur, expTime, _, sid = RC.Compat.ReadPlayerBuff("player", i)
                    if not name then break end
                    local startedNow = dur and dur > 0 and expTime
                        and math.abs((expTime - dur) - w.armT) < 1.5
                    -- Some items name their buff with the same spell they
                    -- cast, so match on that too rather than relying only
                    -- on the aura having appeared at the moment we armed.
                    local sameSpell = w.itemSpellId and sid == w.itemSpellId
                    if startedNow or sameSpell then
                        w.spellId = sid
                        w.expiry = expTime
                        break
                    end
                end
                if w.spellId then
                    -- Buff found, so stop polling entirely and wake up once
                    -- at the exact moment it ends. UNIT_AURA still covers
                    -- early removal, and it costs nothing when auras are
                    -- not changing, so nothing has to spin in between.
                    StopAuraTicker()
                    if w.expiry and w.expiry > now then
                        StopExpiryTimer()
                        expiryTimer = C_Timer.NewTimer((w.expiry - now) + 0.05, function()
                            local cur = watching
                            if cur then FinishWatch(cur, "buff ended") end
                        end)
                    end
                    return
                end

                -- Nothing appeared in the discovery window, so this item
                -- grants no aura. Swap back now rather than sitting on a
                -- fixed timeout.
                if now - w.armT >= DISCOVERY_WINDOW then
                    FinishWatch(w, "no buff found")
                end
                return
            end
            local present = false
            for i = 1, 40 do
                local name, _, _, _, _, _, _, sid = RC.Compat.ReadPlayerBuff("player", i)
                if not name then break end
                if sid == w.spellId then present = true break end
            end
            if not present or (w.expiry and now > w.expiry + 0.3) then
                FinishWatch(w, "buff ended")
            end
        end

        -- AuraTick used to be driven only by the player's UNIT_AURA event.
        -- That works for items whose use effect grants an obvious buff, but
        -- an item that applies no visible player aura - Barbaric Belt among
        -- them - never fires it, so the watch sat armed forever and the slot
        -- was never swapped back. Worse, a stuck watch blocks the next one,
        -- since only one slot is tracked at a time.
        --
        -- The polling is deliberately shaped to be brief. It runs fast for
        -- the fraction of a second it takes to learn whether there is a
        -- buff, then stops: either the buff is found and a single timer is
        -- scheduled for its expiry, or there is none and the swap happens
        -- immediately. Outside that window nothing polls, so this costs no
        -- frame time while you are actually fighting.
        local function ArmWatch(slot, itemId)
            local _, itemSpellId = GetItemSpell(itemId or 0)
            StopAuraTicker()
            StopExpiryTimer()
            watching = { slot = slot, armT = GetTime(), itemSpellId = itemSpellId }

            if RC.RegisterUnitAuraCallback then
                RC:RegisterUnitAuraCallback("GearUseRevert", 0.05, AuraTick)
            end

            local function Pulse()
                if not watching then StopAuraTicker() return end
                AuraTick()
                if not watching then StopAuraTicker() end
            end
            if RC.Profiler and RC.Profiler.TrackTicker then
                auraTicker = RC.Profiler:TrackTicker("GearUseRevert", 0.05, Pulse)
            else
                auraTicker = C_Timer.NewTicker(0.05, Pulse)
            end

            -- The aura is usually already there on the next frame, so look
            -- straight away instead of waiting a whole tick to start.
            C_Timer.After(0, AuraTick)
        end

        f:SetScript("OnEvent", function(_, event, a1, a2, a3)
            if event == "PLAYER_EQUIPMENT_CHANGED" then
                local slot = a1
                local old = lastKnown[slot]
                local new = GetInventoryItemID("player", slot)
                lastKnown[slot] = new
                if Enabled() and new and REVERT_ITEMS[new]
                   and old and not REVERT_ITEMS[old] then
                    pendingPrev[slot] = { prev = old, item = new }
                    RC.db.speedSwapPending = RC.db.speedSwapPending or {}
                    RC.db.speedSwapPending[slot] = { prev = old, item = new }
                end
                UpdateCastReg()
            elseif event == "UNIT_SPELLCAST_SUCCEEDED" then
                if not Enabled() then return end
                local spellId = a3

                local tracked = {}
                for slot in pairs(pendingPrev) do
                    if WornCastsSpell(slot, spellId) then
                        tracked[#tracked + 1] = slot
                    end
                end

                local slot = PickCastSlot(tracked)
                if slot then
                    ArmWatch(slot, GetInventoryItemID("player", slot))
                else
                    local loose = {}
                    for s = 1, 19 do
                        if WornCastsSpell(s, spellId) then
                            loose[#loose + 1] = s
                        end
                    end
                    slot = PickCastSlot(loose)
                    if slot then
                        local worn = GetInventoryItemID("player", slot)
                        pendingPrev[slot] = pendingPrev[slot]
                            or { prev = nil, item = worn }
                        ArmWatch(slot, worn)
                        local tgt = RC.db.speedSwapTargets
                            and RC.db.speedSwapTargets[worn]
                        if not tgt or tgt == 0 then
                            RC:DebugPrint("Swapback: no previous item"
                                .. " recorded and no target configured"
                                .. " for item " .. worn
                                .. " - set one in On-Use Gear Swaps", "gear")
                        end
                    end
                end
            elseif event == "PLAYER_REGEN_ENABLED" then
                f:UnregisterEvent("PLAYER_REGEN_ENABLED")
                local q = queued
                queued = nil
                if q then DoRevert(q.slot, q.rec, "post-combat") end
            elseif event == "PLAYER_ENTERING_WORLD" then
                for slot = 1, 19 do
                    lastKnown[slot] = GetInventoryItemID("player", slot)
                end
                local sp = RC.db and RC.db.speedSwapPending
                if sp then
                    for slot, rec in pairs(sp) do
                        if rec and rec.item
                           and GetInventoryItemID("player", slot) == rec.item then
                            pendingPrev[slot] = { prev = rec.prev, item = rec.item }
                        else
                            sp[slot] = nil
                        end
                    end
                end
                for slot = 1, 19 do
                    local worn = GetInventoryItemID("player", slot)
                    if worn and REVERT_ITEMS[worn] and not pendingPrev[slot] then
                        pendingPrev[slot] = { prev = nil, item = worn }
                    end
                end
                UpdateCastReg()
            end
        end)
        f:RegisterEvent("PLAYER_EQUIPMENT_CHANGED")
        f:RegisterEvent("PLAYER_ENTERING_WORLD")
    end

    C_Timer.After(3, function()
        GM:Initialize()
    end)
end)
